{
  "functions": [
    {
      "source": "functions",
      "codebase": "localwar",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "*.log"],
      "predeploy": ["npm --prefix functions run build"]
    }
  ],
  "firestore": { "rules": "firestore.rules" },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "functions": { "port": 5001 },
    "ui": { "enabled": false }
  }
}
